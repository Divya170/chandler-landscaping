# API port
PORT=4000
# Origin of the Next.js site (CORS). Comma-separate several.
FRONTEND_ORIGIN=http://localhost:3000
# SQLite file (relative to backend/). Default: ../database/app.sqlite
DATABASE_PATH=../database/app.sqlite
# Long random string — signs admin JWTs and short-lived photo URLs
JWT_SECRET=change-me-to-a-long-random-string
# First-boot admin account (only used if no admin exists yet)
ADMIN_EMAIL=admin@chandlerlandscaping.com
ADMIN_PASSWORD=ChangeMe!2026
# Public form rate limit: max submissions per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
# Public address of the site (used for the admin link in alert emails). Defaults to the first FRONTEND_ORIGIN.
SITE_URL=http://localhost:3000
# Email alerts for new quote requests. Leave SMTP_HOST empty to switch alerts off.
# The recipient is "Notification email" in Admin → Settings.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# e.g. Chandler Landscaping <alerts@yourdomain.com> — use an address your SMTP provider allows you to send from
SMTP_FROM=
